{
  "name": "noco-watch",
  "version": "1.0.0",
  "description": "NOCO WATCH – lokale Streaming-Plattform",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "web": "npm --prefix noco-watch-web run dev",
    "web:build": "npm --prefix noco-watch-web run build",
    "web:preview": "npm --prefix noco-watch-web run preview",
    "start": "node server/index.js",
    "app": "electron .",
    "app:dev": "concurrently -k \"npm run server\" \"npm run client\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "desktop": "npm run build && electron ."
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.2.0",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  }
}
